# Production environment. Copy to .env.prod on the server and fill in real
# values. Never commit .env.prod. Bring the stack up with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod pull
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# Which pre-built image to run -- CI pushes to Docker Hub as
# <DOCKERHUB_USERNAME>/advergo-backend:latest (and :sha-<gitsha> for rollback).
DOCKERHUB_USERNAME=
IMAGE_TAG=latest

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=                        # generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
# 127.0.0.1/localhost are needed here even though the site is only ever
# reached via api.advergo.org/admin.advergo.org -- Docker's own HEALTHCHECK
# (inside the container, Host: localhost:8000) and any host-side
# health-check curl (Host: 127.0.0.1:8010) both send those Host headers, and
# Django's DisallowedHost check rejects anything not in this list, health
# checks included. Safe to allow: neither origin is reachable from the internet.
ALLOWED_HOSTS=api.advergo.org,admin.advergo.org,127.0.0.1,localhost

# Non-default admin mount point -- generate a random slug, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(12) + '/')"
# Never use "admin/" in production; keep this value out of any public docs.
ADMIN_URL=

# Used both by the `db` container itself (via docker-compose.prod.yml's
# ${POSTGRES_*} substitution) and by Django's DATABASE_URL below -- keep them
# in sync if you change either.
POSTGRES_USER=advergo
POSTGRES_PASSWORD=                 # generate a strong one, e.g.: openssl rand -hex 24
POSTGRES_DB=advergo
DATABASE_URL=postgres://advergo:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@db:5432/advergo
REDIS_URL=redis://redis:6379/0
# Separate Redis DB index from REDIS_URL above -- also backs DRF's rate
# throttles and the email-OTP 2FA codes (apps.users.otp). Left unset, this
# defaults to redis://localhost:6379/1, which inside the container doesn't
# reach the `redis` service at all -- OTP/2FA and throttling would silently
# break. Always set this explicitly in production.
REDIS_CACHE_URL=redis://redis:6379/1

CORS_ALLOWED_ORIGINS=https://advergo.org
CSRF_TRUSTED_ORIGINS=https://advergo.org,https://api.advergo.org,https://admin.advergo.org

# Email (invoice delivery, etc.) -- a real SMTP provider, not the console backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Advergo <no-reply@advergo.org>

# Base URL of the deployed frontend -- used to build links sent in emails
# (password reset, staff invites). Left at the base.py dev default
# (http://localhost:3000), those emails would link to localhost in production.
FRONTEND_URL=https://advergo.org

# OAuth 2.0 "Web application" client ID from
# https://console.cloud.google.com/apis/credentials -- same value the
# frontend's NEXT_PUBLIC_GOOGLE_CLIENT_ID build-time variable must be set
# to. Leave blank to disable Google Sign-In server-side verification (the
# frontend button also needs its own var set, or it won't render at all).
GOOGLE_CLIENT_ID=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SENTRY_DSN=

# Optional: MaxMind GeoLite2 license key for resolving login-history city/
# country (apps.activity). Free account at https://www.maxmind.com. Without
# this, location resolution degrades to blank for public IPs -- never
# breaks anything, just less informative login history. After setting this
# and deploying, run once:
#   docker compose -p advergo-backend -f docker-compose.prod.yml --env-file .env.prod exec web python manage.py download_geoip_db
MAXMIND_LICENSE_KEY=
