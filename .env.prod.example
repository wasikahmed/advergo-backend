# Production environment. Copy to .env.prod on the server and fill in real
# values. Never commit .env.prod. Bring the stack up with:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=                        # generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=False
ALLOWED_HOSTS=advergo-api.wasikahmed.me

# Used both by the `db` container itself (via docker-compose.prod.yml's
# ${POSTGRES_*} substitution) and by Django's DATABASE_URL below -- keep them
# in sync if you change either.
POSTGRES_USER=advergo
POSTGRES_PASSWORD=                 # generate a strong one, e.g.: openssl rand -base64 32
POSTGRES_DB=advergo
DATABASE_URL=postgres://advergo:CHANGE_ME_SAME_AS_POSTGRES_PASSWORD@db:5432/advergo
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=https://advergo.wasikahmed.me
CSRF_TRUSTED_ORIGINS=https://advergo.wasikahmed.me

# Email (invoice delivery, etc.) -- a real SMTP provider, not the console backend.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Advergo <no-reply@advergo.wasikahmed.me>

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SENTRY_DSN=
