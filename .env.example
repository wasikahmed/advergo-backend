# Copy to .env and fill in real values. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://advergo:advergo@localhost:5432/advergo
REDIS_URL=redis://localhost:6379/0
# Separate Redis DB index -- cache (incl. OTP codes) and Celery broker/queue
# data shouldn't share a keyspace.
REDIS_CACHE_URL=redis://localhost:6379/1

CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Email (dev default: prints to console). Fill in for staging/prod.
# For Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_HOST_USER=you@gmail.com,
# EMAIL_HOST_PASSWORD=<a 16-char App Password from myaccount.google.com/apppasswords
# -- your normal Gmail password will NOT work over SMTP>.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Advergo <no-reply@advergo.com>

# Optional: once EMAIL_BACKEND is real SMTP, apps.core.management.commands
# .seed_dev_data's seeded superuser account uses this address instead of the
# fake admin@advergo.local, so 2FA codes and reset links actually arrive
# somewhere you can read them. Leave unset to keep the fake address.
DEV_ADMIN_EMAIL=

# Cloudinary (media storage: product/fabric/gallery images, quote design uploads).
# Get these from https://console.cloudinary.com/ -- Dashboard page, top of screen.
# Leave blank to use local disk storage (fine for early development).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Base URL of the frontend app -- used to build links sent in emails
# (password reset, staff invites).
FRONTEND_URL=http://localhost:3000

# Google Sign-In: OAuth 2.0 "Web application" client ID from
# https://console.cloud.google.com/apis/credentials. Leave blank to disable
# the /api/v1/auth/google/ endpoint.
GOOGLE_CLIENT_ID=

SENTRY_DSN=
